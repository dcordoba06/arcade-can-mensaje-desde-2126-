lue></block></statement><value name="IF2"><shadow type="logic_boolean" id="^0V7by{M#+-n07TfH2/f"><field name="BOOL">TRUE</field></shadow><block type="gameask" id="q([$Ut-5XM@n2Z$}NUY|"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="Jv]D^smvTRo@o/jWaECq"><field name="TEXT">Mochila +1: $20</field></shadow></value><value name="subtitle"><shadow type="text" id="1ZFTGW4-T86t_1CH8CN;"><field name="TEXT">A: comprar / B: volver</field></shadow></value></block></value><statement name="DO2"><block type="variables_change" id="nw2kEH}:?QyLAIO3PrfO"><field name="VAR" id="3w/?`yfeO)9f_T35p^1]">dinero</field><value name="VALUE"><shadow type="math_number" id="5Uq$caIyXR-7i?sY1f!`"><field name="NUM">-20</field></shadow></value><next><block type="variables_change" id="9k2PcsTYPbi.-J.#HJu#"><field name="VAR" id="8c3[6|!tEI!+P]I--8?$">capacidadPiezas</field><value name="VALUE"><shadow type="math_number" id="*@dc[sCG1JJ9Dc@,IOP2"><field name="NUM">1</field></shadow></value></block></next></block></statement><next><block type="function_call" id="myRfW;0!)*_nM@O|1Z#1"><mutation name="continuarExplorando" functionid="0Wx[nc:7f`Y08huQJB(v"></mutation></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="rDq9rs8x/)/WX#c+?h+8" x="0" y="3333"><mutation name="revelacionFinal" functionid="=Kf1Ax~77.iAn5=ND$v;"></mutation><field name="function_name">revelacionFinal</field><statement name="STACK"><block type="game_show_long_text" id="1WFSQ(IkE)+_vEgQ){gz"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="fsZ2*fGxl7|PuM[+I0y_"><field name="TEXT">Nodo recibe una foto desde 2126: la maquina vieja tiene una placa oculta bajo el polvo.</field></shadow></value><next><block type="game_show_long_text" id="409dQZ;Do=8`jSQDk,{m"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="ydYpdZ4[ttWy/597x3-#"><field name="TEXT">Dice: construida por Nico, Cami, Ale y Cris. Ustedes la construiran cuando sean grandes, despues de aprender a reparar su ciudad.</field></shadow></value><next><block type="game_show_long_text" id="65=Z1cJ#y5WSfEBIN+PH"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id=".esEK*3k1k=U0Ozq3K_#"><field name="TEXT">Somos sus nietos y nietas. Encontramos la maquina y sus planos. El simbolo de las reparaciones se convirtio en la firma de su equipo.</field></shadow></value><next><block type="game_show_long_text" id="U|+%tj%%?3Vdv,@v*~gl"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="~3Ox_CTMwo3vV{F/p|`("><field name="TEXT">La maquina se quedo en 2126. Solo los mensajes viajan por Nodo. Cada vez que ustedes reparaban algo, veiamos mejorar nuestra ciudad.</field></shadow></value><next><block type="game_show_long_text" id="eawW.El)zY+CcvN#vQn5"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="p4(pwXMl@Ig^Ic_o60~1"><field name="TEXT">Gracias por escucharnos. Cuidar el agua, el aire y la naturaleza necesita muchas acciones. El futuro se construye desde hoy.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="}Lna$cu`E8x:/awLfV+d" x="878" y="3333"><mutation name="limpiarEscenario" functionid="U.{H@#Z$`v@W8?R8#K;e"></mutation><field name="function_name">limpiarEscenario</field><statement name="STACK"><block type="sprites_destroy_all_sprites_of_kind" id="wBVJmxdZk:8R^wl5@=Dj"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="kind"><shadow type="spritekind" id="a!^xT3nft11w-+fmeL)*"><field name="MEMBER">Pieza</field></shadow></value><next><block type="sprites_destroy_all_sprites_of_kind" id="*;4@M{)?DOSLf09LxYK3"><mutation xmlns="http://www.w3.org/