ue name="ADD1"><shadow type="text" id="XzNE?fXqa%,_FQ@h!I`]"><field name="TEXT"></field></shadow><block type="variables_get" id="wD6fNgwAPR69f=OD~WOw"><field name="VAR" id=".hSJRi0$qn!,.{PnZN)?">rango</field></block></value></block></value><value name="subtitle"><shadow type="text" id="XoE,@DwbaIqNxV;j2Z~@"><field name="TEXT">Gracias por salvarnos</field></shadow></value><next><block type="gameOver" id="T0{oj]:VujWG-Fj9wo2("><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="effect">effects.confetti</field><value name="win"><shadow type="toggleWinLose" id="nj@/fT_%v]N/!AXr.7ZK"><field name="win">true</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="teZ~D2BbBz7Y:x$aZ~GG" x="0" y="4643"><mutation name="respuestaDel2126" functionid="MMqD).f0xCk[M23?,b+s"></mutation><field name="function_name">respuestaDel2126</field><statement name="STACK"><block type="game_show_long_text" id="hHCaaO8jW!wt/3#!6,F3"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="]pYp-GKPJm36wC]@GSq?"><field name="TEXT">Nodo: enviando a 2126 el reporte de la reparacion...</field></shadow></value><next><block type="controls_if" id="RFVgtU-}Qu*0)mM96q4b"><mutation elseif="1" else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="kMCkrdjqI,E7o9fo*R+L"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="?zr!`r5kRgG^RcW%X@@v"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="r{-I7jg?/y-+pDYTD-}o"><field name="NUM">0</field></shadow><block type="variables_get" id="B;8oB|Ah_fN0OiJjYSmK"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="SU04k[3!:,d.EYqgSZPE"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="game_show_long_text" id="aCYG(.$jmo{i:HR^Xmd|"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="5)kEI!kC;-~8@l=tPD[L"><field name="TEXT">2126: Lo estamos viendo cambiar delante nuestro. El vertedero que había junto al colegio hoy es una plaza con árboles. Reciclar desde su tiempo hizo que nunca llegara a crecer.</field></shadow></value><next><block type="game_show_long_text" id="jpendb.FlEp5r5,p8M^h"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="G*N!!p6YQx#|`,d5k??n"><field name="TEXT">Primera pista: detrás del recolector apareció un símbolo. Los nietos dicen que tambien esta en su maquina. ¿Quien lo puso ahi?</field></shadow></value></block></next></block></statement><value name="IF1"><shadow type="logic_boolean" id="=c:.T0T2A4~ffHXr=Ipm"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="1%;=/}m$uh[m?L@*~mM%"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="^osw|*%q36___zh4[_5f"><field name="NUM">0</field></shadow><block type="variables_get" id="u51,4,}SSLqD}C:@eOa:"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="SOWOe8J~)qAex0`IJsSu"><field name="NUM">2</field></shadow></value></block></value><statement name="DO1"><block type="game_show_long_text" id="Tb-/B6W$Jv[?gGgKx/*v"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="Ppj(_/zNcl[oYV6GT|vA"><field name="TEXT">2126: El río volvió. La planta y el cuidado del rio ayudaron a recuperar el agua. Hoy bebemos de ahí y hay peces otra vez.</field></shadow></value><next><block type="game_show_long_text" id="wu7[+%5vhbDfOeLsysES"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="9CyM^ixkIh{h5NQ^7lyw"><field name="TEXT">Segunda pista: el mismo símbolo está grabado en la planta. Alguien lo dejó ahí antes de que ustedes llegaran.</field></shadow></value></block></next></block></statement><statement name="ELSE"><block type="game_show_long_text" id="^,DpKZhL8fkg`@xOT0w)"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id=",{7X(pi3V+GV)PB;`OaC"><field name="TEXT">2126: Hoy vimos el cielo azul por primera vez. Sus reparaciones iniciaron cien anos de cuidado, mantenimiento y aire mas limpio.</field></shadow></value><next><block type="game_show_long_text" id="9Fo;(=r$[WM87d5?G@Vm"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="TZ5oOtm?v5n2W?YWE=0e"><field name="TEXT">Tercera pista: otra vez el símbolo, y esta vez con una fecha grabada al lado. Es la fecha de hoy. La de ustedes.</field></shadow></value></block></next></block></statement></block></next></block></statement></block><block type="function_definition" id="*n^R@3Gd?YE~m;CpK4{`" x="894" y="4643"><mutation name="prepararPersonaje" functionid=":1{mV??t+/%n32*kS}3Z"></mutation><field name="function_name">prepararPersonaje</field><statement name="STACK"><block type="variables_set" id="6+]^5|vFL_bQeZ]Bh;iC"><field name="VAR" id="8c3[6|!tEI!+P]I--8?$">capacidadPiezas</field><value name="VALUE"><shadow type="math_number" id="KY*+7BZxO`tEuZuxY+_;"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="Gw-@P1;cac[v~T}BQ!YI"><field name="VAR" id="$T^f;odV|2OM!3dkX)lF">velocidad</field><value name="VALUE"><shadow type="math_number" id="5-KBI;sL_)JDpHe6xReE"><field name="NUM">90</field></shadow></value><next><block type="variables_set" id="Pd1Z|%`I!V|am.j4}){v"><field name="VAR" id="fiNfVIfU4mcvfCaLVV|V">descuentoPiezas</field><value name="VALUE"><shadow type="math_number" id="s9+AE+xZJp=O8%2oL)SV"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="pG}|PB%FEf!8:a=2q?^O"><field name="VAR" id="ZduB2!`NCgY*ig4|}Y18">puntosReparacion</field><value name="VALUE"><shadow type="math_number" id="f?DLLzZkyJT)[v(]6Z4+"><fie