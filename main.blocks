pe="logic_boolean" id="Cn*]+2QVMN?O[P87H-lR"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id=":o4ddBsJWTiYi$-TV|Do"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id=".OFs$q]85hzD43NoUc[1"><field name="NUM">0</field></shadow><block type="variables_get" id="S/RfhKWsef8y]k/Rpn`2"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="_!LADDOzq$jt5bdcl0j3"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="function_call" id="#Qme$p|1u:7vaXOwccgb"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="EIG5{9,D@ty+k;@9BzjR"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="h=i-oWj~`R!kv7z,P-PU"><field name="TEXT"></field></shadow><block type="text_join" id="|j||r?obN6DhUnL!sSQ-"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="x%?K12/hH,#cj1CcYq-N"><field name="TEXT">2126: La basura se acumula sin control. El reciclador está roto. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id="wIpX/aILj$u48+,KFrd."><field name="TEXT"></field></shadow><block type="variables_get" id="P+?.)n~3p}=Y)op!M+E,"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="zDLpE/WelOt+u[JzJN+H"><field name="TEXT"> piezas y repáralo. ¡El planeta te necesita!</field></shadow></value></block></value></block></next></block></statement><value name="IF1"><shadow type="logic_boolean" id="]h?9BnP.4R)$o[uS@bx5"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="pMK2.s8z|jn]{+7+Q((K"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="2)|tjk4Ed(Lc$Oof::n7"><field name="NUM">0</field></shadow><block type="variables_get" id=",jc*$k$Fi6lY*HBXduJ,"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="H!4Xjr=|L(wYNsU(x#Y#"><field name="NUM">2</field></shadow></value></block></value><statement name="DO1"><block type="function_call" id="mos(WF9/CBO#t0;67uGt"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="=6cqM7nllk7q5!=0KrfZ"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="?bj]*/MX=y#le/ID5)w#"><field name="TEXT"></field></shadow><block type="text_join" id=",RTN}/s!BSc0F|@DuLF!"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="(=pcRIWX:x9dfs^+i)`s"><field name="TEXT">2126: El agua escasea y el río bajó lleno de basura. La planta de tratamiento está destruida. Necesitas </field></shadow></value><value name="ADD1"><shadow type="text" id="DB5(7hf]CduqB[}q-jX5"><field name="TEXT"></field></shadow><block type="variables_get" id="ISB{!-p:`FF$R1r2[ji#"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="../YP~b^7xF||3xPYtn-"><field name="TEXT"> piezas: búscalas en la ciudad, o métete al agua, engancha la basura y llévala a la planta.</field></shadow></value></block></value></block></next></block></statement><value name="IF2"><shadow type="logic_boolean" id="oDOC([HrtRo[:{;jwPG+"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="yN~a)=5bfk=.+jmeO5z7"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="m?m.M]a`#`aMn#AAz9rD"><field name="NUM">0</field></shadow><block type="variables_get" id="/L`2NM8s0z`?d-)Y|Bkl"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="l8!7Bb1!HrZ;}g[J=3Q-"><field name="NUM">3</field></shadow></value></block></value><statement name="DO2"><block type="function_call" id="2_-CED(Zwh81)3?aK|X."><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="xtUn.yupnHW6u{uaX}!g"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="]S/LNs~f3/9q%iHZBbrI"><field name="TEXT"></field></shadow><block type="text_join" id="1-CBh7+8*N-3/zI?,N?R"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id=";?^!zEwIuF9W,:;%x5~]"><field name="TEXT">2126: El aire es tóxico. Las máquinas de filtración no funcionan hace años. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id="RqLbU605NyeIdK5x%AtV"><field name="TEXT"></field></shadow><block type="variables_get" id="VM!KN!vO`~yUV!(6TwL^"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="*9UAd!4H4bCkR^;-m;mr"><field name="TEXT"> piezas y actívalas. Necesitamos aire limpio.</field></shadow></value></block></value></block></next></block></statement><statement name="ELSE"><block type="function_call" id="l1N{0=nhiS^St.u.Mr^m"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="1Dc+2Grd244=SCQYgQ|l"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id=".99vZm951(=,+A--0Fm{"><field name="TEXT"></field></shadow><block type="text_join" id="rcja0=Yez8+N6W3tHNN1" inline="false"><mutation items="5"></mutation><value name="ADD0"><shadow type="text" id="gn(EkBAxxH(50A=*TRQn"><field name="TEXT">2126: El parque necesita vida. Camina hasta </field></shadow></value><value name="ADD1"><shadow type="text" id="zGWA|U(zLZu3O:hvx?0t"><field name="TEXT"></field></shadow><block type="variables_get" id="XRjdVQV!mezmNB.G]dZ{"><field name="VAR" id="f2N+b!I{CsYP){S#_^Gu">arbolesParaGanar</field></block></value><value name="ADD2"><shadow type="text" id="lh7[S-56M/DyN_+FcE{_"><field name="TEXT"> arboles secos para regarlos. Luego busca </field></shadow></value><value name="ADD3"><shadow type="text" id="hk.fqb^cIY([01mvc3Hm"><field name="TEXT"></field></shadow><block type="variables_get" id="Gz|n1pt[=8F73oGOCLl^"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD4"><shadow type="text" id="(,MFF$yMJ7Zo|B[I#qO2"><field name="TEXT"> piezas y repara el riego. Cuida los brotes verdes: si los pisas, pulsa A sobre ellos para revivirlos.</field></shadow></value></block></value></block></next></block></statement><next><block type="function_call" id="cxgI!pT0RJch6g|Okq11"><mutation name="continuarExplorando" functionid="0Wx[nc:7f`Y08huQJB(v"></mutation></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="%$3@%Y},C+$4bgDhicGS" x="3307" y="4643"><mutation name="anunciarCiudad" functionid="UVFkYN[zj]@Js+JVa|xu"></mutation><field name="function_name">anunciarCiudad</field><statement name="STACK"><block type="controls_if" id="|]PahX_/%%dSj}=BR(H+"><mutation elseif="2" else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="kL!+1Ziyjb5U+bBn4?uq"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="GGFEgfoY@2xdvQbrdO?j"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="oC%k(hdn^JR+Z:B+bVI0"><field name="NUM">0</field></shadow><block type="variables_get" id="tWy1Ssj/L8Q#JgcUr,#p"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="E/liEo~NHUIOweS6.-4i"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="gameSplash" id="_4s1Y?@^8`8Wu7;NdHi%"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="}Ql3T81NTxS#KTe?!K!`"><field name="TEXT">CIUDAD DEL RECICLAJE</field></shadow></value><value name="subtitle"><shadow type="text" id="q6EHPT3)bVvTiQ)dm5%N"><field name="TEXT">Mensaje 1 de 4</field></shadow></value></block></statement><value na