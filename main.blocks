3333"><mutation name="presentarHistoria" functionid="cq%Pg;aAHEARZ)qvXnIK"></mutation><field name="function_name">presentarHistoria</field><statement name="STACK"><block type="gamesetbackgroundimage" id="gs^MZv`Af07Ev]30kAbY"><value name="img"><shadow type="background_image_picker" id="@z#^1+9y)qon+]CR;yx["><field name="img">assets.image`portadaHistoria0`</field><data>{"commentRefs":[],"fieldData":{"img":"myImages.portadaHistoria"}}</data></shadow></value><next><block type="gameSplash" id="ZtZr)b?@ihR0_e^K{(RZ"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="wVQsJWo.7%PKxL;.NAUv"><field name="TEXT">Mensaje desde 2126</field></shadow></value><value name="subtitle"><shadow type="text" id="^_.aR*7}Hm|xPY;tR8aF"><field name="TEXT">Ayuda hoy al futuro</field></shadow></value><next><block type="game_show_long_text" id="0`4my/kz+-/)#JYE1_$C"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="}!3h%r7tAr`gUK`_Ph+/"><field name="TEXT">2026. Nico, Cami, Ale y Cris reciben un mensaje de una cuenta desconocida en Nodo, su aplicacion de chat. Dice venir de 2126...</field></shadow></value><next><block type="game_show_long_text" id="`bvg%m^:osnvRn+(V02y"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="dOJ`#[o8;s;d2R1#7Nnj"><field name="TEXT">Somos sus nietos y nietas. Encontramos una maquina vieja que envia mensajes al pasado. La conectamos a Nodo. Aqui falta agua limpia, hay basura y casi no quedan zonas verdes.</field></shadow></value><next><block type="game_show_long_text" id="fh]oNz!?%!)QH[UcOloP"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="fW:Jj!L@y`m%hVSyUTd*"><field name="TEXT">Sus acciones de hoy cambian nuestro futuro. Elige tu personaje. Flechas: caminar. A: usar equipos. B: leer Nodo. La terminal de la base recibe los mensajes. No hay combates.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="4eUewbmA@6X~}__}uU*-" x="9534" y="3333"><mutation name="finalDelJuego" functionid="t{,?l1*9}{#05Ygj2d_e"></mutation><field name="function_name">finalDelJuego</field><statement name="STACK"><block type="variables_set" id=";=c-Dat}(e7K@CNC|0BP"><field name="VAR" id=";(Z2Kd8aY=pqpEvdUhM+">estado</field><value name="VALUE"><shadow type="math_number" id="0mh-a0aAX,NT=i1B?C^V"><field name="NUM">0</field></shadow><block type="text" id="eKB0.jY2Cfu8Jng75#|N"><field name="TEXT">mensaje</field></block></value><next><block type="game_control_sprite" id="H?{w.s8*6{z~dCqQcD/2"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="b]gp]#^s%_=#IDNq##;m"><field name="VAR" id="6O,tWiXxRkaE3*UBfMAl">jugador</field></block></value><value name="vx"><shadow type="spriteSpeedPicker" id="-^[[XJD)y[FYtHZW0V.P"><field name="speed">0</field></shadow></value><value name="vy"><shadow type="spriteSpeedPicker" id="HAS6@uz^O:fn)FW8y_B,"><field name="speed">0</field></shadow></value><next><block type="game_show_long_text" id="Jf[eQ_@.P|6(WIXER8Jj"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="-YsRk~_!?6~QvKQ;2EO+"><field name="TEXT">Nodo: enviando a 2126 el reporte del parque...</field></shadow></value><next><block type="game_show_long_text" id="{T5XT0tey^DEj=qCm-s]"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="rCIZ%nOR84,Kb)M`dSTm"><field name="TEXT">2126: El parque esta lleno de gente. Hay sombra, hay pajaros, y el aire huele a tierra mojada. Crecimos jugando aqui.</field></shadow></value><next><block type="function_call" id="x:N=Sd,7Cu:UK-M-Ogl6"><mutation name="revelacionFinal" functionid="=Kf1Ax~77.iAn5=ND$v;"></mutation><next><block type="controls_if" id="b}o%DsGd`:tN1!u=qgBz"><mutation elseif=